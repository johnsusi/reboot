{
    "$schema": "https://cmake.org/cmake/help/latest/_downloads/3e2d73bff478d88a7de0de736ba5e361/schema.json",
    "version": 8,
    "include": [
        "cmake/presets/prefixes.json",
        "cmake/presets/generators.json",
        "cmake/presets/toolchains.json"
    ],
    "configurePresets": [
        {
            "name": "default",
            "inherits": [
                "base",
                "ninja"
            ]
        },
        {
            "name": "ci-ninja-clang",
            "inherits": [
                "ci",
                "ninja",
                "clang"
            ]
        },
        {
            "name": "ci-ninja-gcc",
            "inherits": [
                "ci",
                "ninja",
                "gcc"
            ]
        },
        {
            "name": "ci-ninja-clang-homebrew-osx",
            "inherits": [
                "ci",
                "ninja",
                "clang-homebrew",
                "osx"
            ],
            "displayName": "LLVM (Homebrew)",
            "description": "Targeting latest LLVM from Homebrew"
        },
        {
            "name": "ci-ninja-clang-msys2-clang64-windows",
            "inherits": [
                "ci",
                "ninja",
                "clang-msys2-clang64",
                "windows"
            ],
            "displayName": "LLVM (MSYS2)",
            "description": "Targeting latest LLVM from MSYS2"
        },
        {
            "name": "ci-ninja-gcc-msys2-ucrt64-windows",
            "inherits": [
                "ci",
                "ninja",
                "gcc-msys2-ucrt64",
                "windows"
            ],
            "displayName": "GCC (MSYS2)",
            "description": "Targeting latest GCC from MSYS2"
        },
        {
            "name": "ci-msvc-2026-v142-x64-windows",
            "inherits": [
                "ci",
                "msvc-2026",
                "v142-x64",
                "windows"
            ],
            "displayName": "MSVC 2026 x64",
            "description": "Targeting Visual Studio 2026 (v142 toolset)"
        },
        {
            "name": "ci-msvc-2026-v143-x64-windows",
            "inherits": [
                "ci",
                "msvc-2026",
                "v143-x64",
                "windows"
            ],
            "displayName": "MSVC 2026 x64",
            "description": "Targeting Visual Studio 2026 (v143 toolset)"
        },
        {
            "name": "ci-msvc-2026-v145-x64-windows",
            "inherits": [
                "ci",
                "msvc-2026",
                "v145-x64",
                "windows"
            ],
            "displayName": "MSVC 2026 x64",
            "description": "Targeting Visual Studio 2026 (v145 toolset)"
        }
    ]
}